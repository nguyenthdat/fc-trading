SSI_FCTRADING_CONSUMER_ID=your-consumer-id
SSI_FCTRADING_CONSUMER_SECRET=your-consumer-secret
SSI_FCTRADING_PUBLIC_KEY=your-public-key
SSI_FCTRADING_PRIVATE_KEY=your-base64-xml-private-key

# Optional overrides
SSI_FCTRADING_API_URL=https://fc-tradeapi.ssi.com.vn/
SSI_FCTRADING_STREAM_URL=https://fc-tradehub.ssi.com.vn/
SSI_FCTRADING_TWO_FACTOR_TYPE=0

# Opt-in sandbox smoke test. Production URLs are rejected by the test.
# SSI_FCTRADING_SANDBOX_SMOKE=I_UNDERSTAND_SANDBOX_NETWORK_CALLS
# SSI_FCTRADING_SANDBOX_API_URL=https://sandbox-api.example/
# SSI_FCTRADING_SANDBOX_STREAM_URL=https://sandbox-stream.example/
# SSI_FCTRADING_VERIFICATION_CODE=your-current-pin-or-otp
# SSI_FCTRADING_NOTIFY_ID=-1
